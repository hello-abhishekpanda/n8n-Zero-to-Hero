      "id": "340ea35c-6f08-49dd-93a1-f233631bb7af",
      "name": "Is Customer Valid?"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\n\nconst requestId =\n  `req_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n\nreturn [\n  {\n    json: {\n      ...input,\n      requestId\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -240,
        -120
      ],
      "id": "afe3fe40-fe51-4a47-b8b7-46d2208be403",
      "name": "Create Request ID"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nconst body = input.body ?? {};\n\nif (!body.name || !body.email || !body.company) {\n  throw new Error('Normalize Customer expected body.name, body.email and body.company');\n}\n\nconst enrichmentUserId = Number(body.userId ?? 1);\n\nreturn [\n  {\n    json: {\n      requestId: input.requestId,\n      enrichmentUserId,\n      customer: {\n        name: String(body.name).trim(),\n        email: String(body.email).trim().toLowerCase(),\n        company: String(body.company).trim(),\n        budget: body.budget ?? null,\n        country: body.country ?? null,\n        source: body.source ?? 'webhook',\n        receivedAt: new Date().toISOString()\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        -120
      ],
      "id": "4c16ec35-f801-47f9-b63f-7c8ef7c4bae3",
      "name": "Normalize Customer"
    },
    {
      "parameters": {
        "url": "=https://jsonplaceholder.typicode.com/users/{{ $json.enrichmentUserId }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        250,
        -120
      ],
      "id": "24d54d15-2578-4f05-8936-04882fc766c0",
      "name": "GET Enrichment Data"
    },
    {
      "parameters": {
        "jsCode": "const api = $json;\nconst original = $('Normalize Customer').first().json;\n\nreturn [\n  {\n    json: {\n      success: true,\n      message: 'Customer enriched successfully',\n      requestId: original.requestId,\n      status: 'ENRICHED',\n      customer: original.customer,\n      enrichment: {\n        externalId: api.id ?? null,\n        name: api.name ?? null,\n        username: api.username ?? null,\n        email: api.email ?? null,\n        phone: api.phone ?? null,\n        website: api.website ?? null,\n        company: api.company?.name ?? null,\n        city: api.address?.city ?? null\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        510,
        -120
      ],
      "id": "6a51cd1c-f348-4234-9477-cdc4b0e10eab",
      "name": "Build Enriched Customer"
    },
