      "id": "4bce9dd8-5dfd-413b-8e15-c6a365aa6a97",
      "name": "Customer Qualification Webhook",
      "webhookId": "517554a6-56b1-44cb-8a25-16772f0b42cc"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? {};\n\nconst requiredFields = [\n  'name',\n  'email',\n  'company',\n  'budget',\n  'employees',\n  'timelineMonths'\n];\n\nconst missingFields = requiredFields.filter((field) => {\n  const value = body[field];\n  return value === undefined ||\n    value === null ||\n    String(value).trim() === '';\n});\n\nreturn [\n  {\n    json: {\n      ...$json,\n      validation: {\n        valid: missingFields.length === 0,\n        missingFields\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -680,
        0
      ],
      "id": "843bc6c9-0812-46fb-b9f8-7e6715a435d0",
      "name": "Validate Customer"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "c3443e52-2c7c-4af8-b4db-5675a21c299e",
              "leftValue": "={{ $json.validation.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -460,
        0
      ],
      "id": "715cf5e2-eda3-4fe1-982f-2c3d4a5b17ca",
      "name": "Is Customer Valid?"
    },
    {
      "parameters": {
        "jsCode": "const requestId =\n  `req_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;\n\nreturn [\n  {\n    json: {\n      ...$json,\n      requestId\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -220,
        -120
      ],
      "id": "aa8b7fe8-52d6-4860-b8bf-8aa23be0da39",
      "name": "Create Request ID"
    },
    {
      "parameters": {
        "jsCode": "const input = $json;\nconst body = input.body ?? {};\n\nreturn [\n  {\n    json: {\n      requestId: input.requestId,\n      customer: {\n        name: String(body.name).trim(),\n        email: String(body.email).trim().toLowerCase(),\n        company: String(body.company).trim(),\n        budget: Number(body.budget),\n        employees: Number(body.employees),\n        timelineMonths: Number(body.timelineMonths),\n        country: body.country ? String(body.country).trim() : null,\n        source: body.source ?? 'webhook',\n        receivedAt: new Date().toISOString()\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        -120
      ],
      "id": "2f10c2ad-0da8-4e75-9175-94c45107db41",
      "name": "Normalize Customer"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nconst customer = data.customer;\n\nconst budget = Number(customer.budget ?? 0);\nconst employees = Number(customer.employees ?? 0);\nconst timelineMonths = Number(customer.timelineMonths ?? 999);\n\nconst reasonCodes = [];\n\nif (budget >= 100000) reasonCodes.push('HIGH_BUDGET');\nif (employees >= 1000) reasonCodes.push('ENTERPRISE_SIZE');\nif (timelineMonths <= 3) reasonCodes.push('URGENT_TIMELINE');\n\nlet tier = 'COLD';\nlet score = 20;\n\nif (\n  budget >= 100000 &&\n  employees >= 1000 &&\n  timelineMonths <= 3\n) {\n  tier = 'HOT';\n  score = 90;\n} else if (\n  budget >= 25000 ||\n  employees >= 200\n) {\n  tier = 'WARM';\n  score = 60;\n}\n\nreturn [\n  {\n    json: {\n      ...data,\n      qualification: {\n        tier,\n        score,\n        reasonCodes,\n        evaluatedAt: new Date().toISOString()\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -120
      ],
      "id": "8ab4891e-e53c-4a0c-bf50-0d445cbe1542",
      "name": "Calculate Qualification"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict",
                  "version": 2
                },
                "conditions": [
                  {
                    "id": "749ee635-c0ca-4683-84da-34eb2071231f",
                    "leftValue": "={{ $json.qualification.tier }}",
                    "rightValue": "HOT",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "HOT"
            },
            {
              "conditions": {
