        "jsCode": "return [\n  {\n    json: {\n      ...$json,\n      routing: {\n        route: 'MANUAL_REVIEW',\n        priority: 'REVIEW',\n        action: 'Unknown qualification tier - review manually'\n      }\n    }\n  }\n];"
      },
