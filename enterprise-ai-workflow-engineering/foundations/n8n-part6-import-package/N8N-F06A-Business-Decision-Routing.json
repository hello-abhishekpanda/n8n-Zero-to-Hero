    },
    {
      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      ...$json,\n      routing: {\n        route: 'SALES',\n        priority: 'HIGH',\n        action: 'Immediate sales follow-up'\n      }\n    }\n  }\n];"
      },
